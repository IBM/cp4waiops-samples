              "options": {
                "from": 5,
                "result": {
                  "color": "yellow",
                  "index": 5,
                  "text": "5+ pods have exceeded 80% of their CPU limits - review CPU graphs for spikes"
                },
                "to": 10000
              },
              "type": "range"
            }
