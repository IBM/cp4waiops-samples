            {
              "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
              },
              "editorMode": "code",
              "expr": "time() -topk(5, sum(kube_pod_start_time{pod=~\".*chatops-orch.*|.*grpc-snow.*|\"}) by (pod))",
              "legendFormat": "__auto",
              "range": true,
              "refId": "A"
