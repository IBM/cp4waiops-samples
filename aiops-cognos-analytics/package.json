{
  "name": "aiops-custom-widget-cognos-integration",
  "version": "1.1.0",
  "description": "Custom AIOps widgets for Cognos",
  "main": "index.js",
  "scripts": {
    "clean:dist": "rimraf dist",
    "test": "mocha",
    "lint": "node node_modules/.bin/eslint widgets/**/*.js --fix",
    "lint:diff": "npm-run-all -c -p lint:js:diff",
    "lint:js:diff": "eslint $(git diff --name-only --diff-filter=dr HEAD | grep -E '.js$|.jsx$') --max-warnings=0",
    "build": "npm-run-all clean:dist lint build:webpack",
    "build:webpack": "node scripts/webpackBundleWidgets.js",
    "watch": "babel widgets/js -d dist/js --watch --verbose --source-maps"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "handlebars": "^4.7.9"
  },
  "devDependencies": {
    "@babel/cli": "^7.8.4",
    "@babel/core": "^7.8.7",
    "@babel/eslint-parser": "^7.25.1",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/plugin-transform-modules-amd": "^7.24.1",
    "@babel/preset-env": "^7.8.7",
    "@babel/preset-react": "^7.8.3",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^9.1.3",
    "babel-minify": "^0.5.1",
    "chai": "^4.5.0",
    "cpx-fixed": "^1.6.0",
    "eslint": "^7.5.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-notice": "^0.9.10",
    "eslint-plugin-react": "^7.34.1",
    "glob": "^10.5.0",
    "mocha": "^12.0.1",
    "nconf": "^0.12.1",
    "npm-run-all": "^4.1.5",
    "pg": "^8.12.0",
    "rimraf": "^5.0.5",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "zip-lib": "^1.0.4"
  },
  "optionalDependencies": {
    "ibm_db": "^4.0.1"
  },
  "overrides": {
    "yargs-parser": ">=13.1.2",
    "serialize-javascript": ">=7.0.3",
    "adm-zip": "0.6.1"
  },
  "mocha": {
    "recursive": true,
    "timeout": 10000
  }
}
